# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side (Settings → API → service_role) — never expose in NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare R2 (S3-compatible) ──────────────────────────────────────────
# Account ID (R2 → Overview)
R2_ACCOUNT_ID=
# R2 API tokens (R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name
R2_BUCKET_NAME=

# ─── Optional ────────────────────────────────────────────────────────────────
# Canonical site origin for metadata/OG. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL automatically, so only set when overriding.
# NEXT_PUBLIC_SITE_URL=
